# .env — single source of truth for the AWS + Solace DIL demo (all three parts).
#
# Copy this to `.env` and fill in the real values, then every script in this
# bundle reads from it instead of you re-typing IPs and credentials into a
# dozen different SSH sessions. Nothing in this file is sensitive enough to
# require a vault for a throwaway demo stack, but don't commit a filled-in
# copy to a shared repo — it does contain broker admin credentials.
#
# Order of operations (matches the Tactical Field Manual's phases):
#   1. ./00-aws-provision.sh          (local)   -> Phase 00/01, fills AWS_* below automatically
#   2. ./01-shaper-setup.sh           (shaper)  -> Phase 02
#   3. ./02-source-setup.sh           (source)  -> Phase 03 (source half)
#   4. ./03-receiver-setup.sh         (receiver)-> Phase 03 (receiver half) + Phase 11C
#   5. ./04-configure-brokers.sh      (local)   -> Phase 04/12 (mostly automated, one manual step)
#   6. ./05-check-bridges.sh          (local)   -> verify Phase 04's bridges are actually Up
#   7. ./06-gpu-setup.sh              (gpu)     -> Phase 08/09 (Part Two, optional)
#   8. ./track_gen.sh                 (source)  -> Phase 11 (Part Three, optional)
#   9. ./07-flood-test.sh             (source)  -> Phase 06/13
#  10. ./08-teardown.sh <role>        (each host)-> Phase 07/10/14
#  11. ./00-aws-teardown.sh           (local)   -> Phase 07's AWS-side teardown

# ---- AWS ---------------------------------------------------------------
AWS_REGION=us-east-1
KEY_NAME=your-existing-keypair
SSH_KEY_PATH=~/Downloads/your-key.pem

# Filled in automatically by 00-aws-provision.sh if left blank — or paste in
# values from Phase 00's output table if you provisioned by hand instead.
INSTANCE_SRC=
INSTANCE_SHAPE=
INSTANCE_RCV=
INSTANCE_GPU=
IP_SRC_PUB=
IP_SRC_PRIV=
IP_SHAPE_PUB=
IP_RCV_PUB=
IP_RCV_PRIV=
IP_GPU_PUB=
ENI_SHAPE=
VPC_ID=
SUBNET_SRC=
SUBNET_SHAPE=
SUBNET_RCV=
SG_ID=
IGW_ID=
RTB_SRC=
RTB_SHAPE=
RTB_RCV=

# ---- Link shaping (Phase 02) -------------------------------------------
SHAPE_RATE_KBIT=768
SHAPE_DELAY_MS=100
SHAPE_JITTER_MS=20
SHAPE_LOSS_PCT=2
SHAPE_LOSS_CORRELATION_PCT=25

# ---- Solace brokers ------------------------------------------------------
# Set real passwords below in your own .env (never commit a filled-in .env —
# see .gitignore). These are deliberately blank placeholders, not working
# credentials.
BROKER_MSGVPN=default
BROKER_ADMIN_USER=admin
BROKER_ADMIN_PASS=changeme
BROKER_A_SEMP_PORT=8080
BROKER_B_SEMP_PORT=8080
BROKER_SMF_PORT=55555
BROKER_MQTT_PORT=1883
BROKER_MQTT_WS_PORT=8000

VIDEO_DEMO_USER=video_demo
VIDEO_DEMO_PASS=changeme
BRIDGE_SVC_USER=bridge_svc
BRIDGE_SVC_PASS=changeme

CAM_NAME=c01
BRIDGE_GUARANTEED_QUEUE=bridge2bQ

# ---- Video pipeline (Phase 00/03/11C) ----------------------------------
# Local path to the source clip to upload — leave blank to fall back to the
# Big Buck Bunny stand-in described in Phase 03.
SOURCE_VIDEO_LOCAL_PATH=
RTSP_BRIDGE_HTTP_PORT=8888
RTSP_BRIDGE_RTMP_PORT=1935

# ---- Sensor fusion / track_gen.sh (Phase 11) ---------------------------
CELL_SIZE=0.01
TRACK_LAT=32.7473
TRACK_LON=-97.0945
TRACK_ID=trk-042
SITE_NAME=site1

# ---- Flood test (Phase 06/13) -------------------------------------------
FLOOD_BW=10M
FLOOD_DURATION_SEC=300

# ---- GPU / drone detection (Phase 08/09, optional Part Two) -----------
# Set to true to have 00-aws-provision.sh also launch the GPU instance
# (reusing the receiver's subnet/security group, per Phase 08). Leave false
# if you're only building Part One/Three.
BUILD_PART_TWO=false
GPU_INSTANCE_TYPE=g4dn.xlarge
YOLO_WEIGHTS_URL=https://huggingface.co/doguilmak/Drone-Detection-YOLOv11x/resolve/main/weight/best.pt?download=true
